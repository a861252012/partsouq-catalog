# Host 使用此 port；Docker 服務內一律透過 mysql:3306 連線。
PARTSOUQ_DB_HOST=127.0.0.1
PARTSOUQ_DB_PORT=3308
PARTSOUQ_DB_NAME=partsouq_catalog
PARTSOUQ_DB_USER=partsouq
PARTSOUQ_DB_PASSWORD=change-this-password
PARTSOUQ_MYSQL_ROOT_PASSWORD=change-this-root-password

# Compose 只會把各服務需要的變數傳入 container；MySQL root 密碼不會傳給
# scheduler 或後台，兩套後台的認證資訊也不會互相共用。
# 8000 資料品質 API 的寫入與受保護讀取使用 X-Admin-Token。
PARTSOUQ_ADMIN_TOKEN=change-this-admin-token
PARTSOUQ_ADMIN_TRUSTED_HOSTS=127.0.0.1,localhost,admin.partsouq.localhost
# 8086 站方後台使用 session + CSRF，Compose 強制啟用認證且只發布到 host loopback。
PARTSOUQ_STATION_ADMIN_SECRET_KEY=change-this-random-session-secret
PARTSOUQ_STATION_ADMIN_USERNAME=admin
PARTSOUQ_STATION_ADMIN_PASSWORD=change-this-admin-password
PARTSOUQ_STATION_ADMIN_REQUIRE_AUTH=1
PARTSOUQ_STATION_ADMIN_ALLOWED_HOSTS=localhost,127.0.0.1,admin.partsouq.localhost

# macOS host catalog scheduler 使用的 CloakBrowser Python。2026-08-22
# 實測 host 可進型錄頁、目前 Linux/Xvfb image 不行；其他服務不使用此設定。
# 留空會使用 ~/.venvs/partsouq-cloak/bin/python。
PSQ_CLOAK_PYTHON=

# 爬蟲：以 CloakBrowser cookie 進行一般 HTTP 請求；challenge 時
# 自動刷新 cookie 並重試（--no-browser 模式只用已存 cookie）。
PSQ_WORKERS=4
PSQ_REQUEST_RATE=0.5
PSQ_REQUEST_BURST=4
# Compose 正式 bounded 排程目標。macOS host 正式啟動腳本會固定覆寫為 10000，
# 不接受舊 sample 環境值降級。
PSQ_BOUNDED_PARTS=10000
# Formal live-evidence hard limits. Exceeding any limit aborts publication and
# keeps the previous bounded snapshot; evidence is compressed before DB storage.
PSQ_EVIDENCE_MAX_BODY_BYTES=8388608
PSQ_EVIDENCE_MAX_RUN_BYTES=1073741824
PSQ_EVIDENCE_MAX_ARTIFACTS=50000
# Compose 使用此值；macOS host 正式啟動腳本固定覆寫為 0。
# 例如 1000=只保留最多 1000 筆 normalized fitment sample。
PSQ_LIMIT_PARTS=0
PARTSOUQ_HOME=.
