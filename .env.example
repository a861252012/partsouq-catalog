# Host 使用此 port；Docker 服務內一律透過 mysql:3306 連線。
PARTSOUQ_DB_HOST=127.0.0.1
PARTSOUQ_DB_PORT=3308
PARTSOUQ_DB_NAME=partsouq_catalog
PARTSOUQ_DB_USER=partsouq
PARTSOUQ_DB_PASSWORD=change-this-password
PARTSOUQ_MYSQL_ROOT_PASSWORD=change-this-root-password

# 8000 資料品質 API 的寫入與受保護讀取使用 X-Admin-Token。
# 8086 站方後台使用 session + CSRF，預設只綁定本機 loopback。
PARTSOUQ_ADMIN_TOKEN=change-this-admin-token

# 僅適用於原生 host 執行：CloakBrowser（指紋修補版 Chromium）的
# Python 直譯器。Compose 的 PartSouq scheduler 會覆寫此值，改用 image
# 內建的 Linux runtime、Chromium 與 Xvfb；其他服務不使用此設定。
PSQ_CLOAK_PYTHON=/absolute/path/to/.cloak-venv/bin/python

# 爬蟲：以 CloakBrowser cookie 進行一般 HTTP 請求；challenge 時
# 自動刷新 cookie 並重試（--no-browser 模式只用已存 cookie）。
PSQ_WORKERS=4
PSQ_REQUEST_RATE=0.5
PSQ_REQUEST_BURST=4
# 0=完整爬取；例如 1000=只保留最多 1000 筆 normalized fitment sample。
PSQ_LIMIT_PARTS=0
PARTSOUQ_HOME=.
