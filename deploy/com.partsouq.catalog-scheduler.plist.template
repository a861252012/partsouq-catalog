<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.partsouq.catalog-scheduler</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PROJECT_ROOT__/deploy/run-macos-catalog-scheduler.zsh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__PROJECT_ROOT__</string>
  <key>LimitLoadToSessionType</key>
  <string>Aqua</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>60</integer>
  <key>StandardOutPath</key>
  <string>/tmp/partsouq-catalog-scheduler.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/partsouq-catalog-scheduler.stderr.log</string>
</dict>
</plist>
